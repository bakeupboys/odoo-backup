# .env.backup
# Restic Repository Location (SFTP)
RESTIC_REPOSITORY=sftp:user@remote-server.com:/home/user/odoo-backups

# The password to encrypt your local backup repository
RESTIC_PASSWORD=secure_long_password_for_encryption

# Remote Server SSH Password (if not using SSH keys)
# It is highly recommended to use SSH Keys instead!
# RESTIC_REST_PASSWORD=...

# Here you can specify the odoo db name if it is not the same as the directory name
# COMPOSE_PROJECT_NAME=project_name
