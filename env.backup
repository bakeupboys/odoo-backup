# =============================================================================
# .env.backup — Configuration for backup.sh
# Keep this file private: chmod 600 .env.backup
# =============================================================================

# -----------------------------------------------------------------------------
# Project / Database
# -----------------------------------------------------------------------------

# Override the database name if it differs from the directory name.
# If unset, the script uses the parent folder name as the DB name.
COMPOSE_DB_NAME=database-name

# -----------------------------------------------------------------------------
# PostgreSQL connection
# -----------------------------------------------------------------------------

PG_USER=odoo
PG_HOST=localhost
PG_PORT=5432

# Password for pg_dump. Alternatively, configure a ~/.pgpass file and leave
# this unset — that is the more secure option for production servers.
# PGPASSWORD=changeme

# -----------------------------------------------------------------------------
# Odoo filestore
# -----------------------------------------------------------------------------

# Absolute path to the filestore for this database.
# Default if unset: /var/lib/odoo/.local/share/Odoo/filestore/<DB_NAME>
ODOO_FILESTORE_DIR=/var/lib/odoo/.local/share/Odoo/filestore/<DB_NAME>

# -----------------------------------------------------------------------------
# Restic — repository location (pick ONE backend and fill it in)
# -----------------------------------------------------------------------------

# -- SFTP example (most common for a remote VPS / NAS) -----------------------
RESTIC_REPOSITORY=sftp:backup-host:.

# -- S3-compatible (AWS S3, Hetzner Object Storage, Backblaze B2, etc.) ------
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/my-bucket/myodoo
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# -- Backblaze B2 ------------------------------------------------------------
# RESTIC_REPOSITORY=b2:my-bucket-name:/myodoo
# B2_ACCOUNT_ID=your_account_id
# B2_ACCOUNT_KEY=your_application_key

# -- Local path (useful for a mounted NFS share or external drive) ------------
# RESTIC_REPOSITORY=/mnt/backup-drive/restic-repos/myodoo

# -----------------------------------------------------------------------------
# Restic — repository password
# -----------------------------------------------------------------------------

# Used to encrypt/decrypt the restic repository. Store this somewhere safe —
# losing it means losing access to all backups in this repo.
RESTIC_PASSWORD=very-secure-password